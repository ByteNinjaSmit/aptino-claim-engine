# LLM provider configuration.
# Leave LLM_PROVIDER=offline to run fully deterministically with no API key
# (used for grading/reproducibility). Set to "openai_compatible" plus the
# variables below to use a real LLM (Gemini, OpenAI, Groq, Together, local Ollama, etc.)
LLM_PROVIDER=offline

# Only required when LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.5-flash-lite

# Retrieval / index paths (defaults are fine for local dev)
POLICY_PDF_PATH=data/policy/USGIC-CSCIndividualHealthInsurance_2017-2018.pdf
INDEX_DIR=data/index

# Retrieval tuning
DENSE_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVAL_TOP_K_DENSE=15
RETRIEVAL_TOP_K_SPARSE=15
RETRIEVAL_TOP_K_FUSED=10
RETRIEVAL_TOP_K_FINAL=5

# API
API_HOST=0.0.0.0
API_PORT=8000
